# macOS
.DS_Store

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# TeX / LaTeX intermediates
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.xdv

# Common generated helpers
.pandoc_wrapper.auto.md
missfont.log

# Per-example compile scratch (regenerated by translate_latex/assemble.sh,
# which symlinks images and re-runs xelatex into build/final/)
build/

# Never commit a nested repository.  Example directories belong to this repo and
# carry no history of their own; if one is copied in from elsewhere, strip its
# .git/ rather than committing it as a submodule-by-accident.
**/.git/

# Oversized binaries.  The per-example source and translated PDFs are 3-6MB and
# ARE tracked, so *.pdf is deliberately not listed here -- but keep anything
# over 10MB out, and these never belong in a translation example anyway.
*.tar.gz
*.tgz
*.zip
*.7z
*.safetensors
*.ckpt
*.onnx
*.pt
*.pth

# Editor / temp
*.swp
*.tmp
